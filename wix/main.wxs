<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="OpenNex"
           Version="$(var.Version)"
           Manufacturer="OpenNex"
           Language="1033"
           UpgradeCode="11111111-2222-3333-4444-555555555555">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Full install wizard (Welcome -> License -> Install directory ->
         progress -> finish). Without a UIRef the MSI falls back to the
         bare Basic UI: UAC + a progress bar, no directory choice —
         which is what users reported as "the installer just flashed". -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <!-- WiX v3 CANNOT merge controls into a library dialog (same-Id
           Dialog = LGHT0091 duplicate symbol). Instead: a full copy of
           the library's directory page under a UNIQUE Id, plus the
           desktop-shortcut checkbox, and the wizard is rerouted through
           it with LOWER Order than the library's own NewDialog publishes
           (the first ControlEvent whose condition is true wins, so ours
           at Order=0 preempts the library's default-Order route). -->
      <Dialog Id="OpenNexInstallDirDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallDirDlgTitle)" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="290" Height="30" NoPrefix="yes" Text="!(loc.InstallDirDlgFolderLabel)" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="100" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="120" Width="56" Height="17" Text="!(loc.InstallDirDlgChange)" />
        <Control Id="DesktopShortcutCheckbox"
                 Type="CheckBox"
                 X="20" Y="150" Width="290" Height="17"
                 Property="INSTALLDESKTOPSHORTCUT"
                 CheckBoxValue="1"
                 Text="Create a desktop shortcut" />
      </Dialog>
      <!-- Route INTO our page (Order=0 preempts the library's
           LicenseAgreementDlg->InstallDirDlg default route). -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="OpenNexInstallDirDlg" Order="0">LicenseAccepted = "1"</Publish>
      <!-- Button behaviour inside our page: replicate the library's
           InstallDirDlg publishes verbatim (they are bound to the
           dialog Id, so they must be re-declared for ours). -->
      <Publish Dialog="OpenNexInstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="OpenNexInstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="OpenNexInstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="OpenNexInstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="OpenNexInstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
      <Publish Dialog="OpenNexInstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="OpenNexInstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <!-- Route BACK into our page from the confirmation step. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OpenNexInstallDirDlg" Order="0">NOT Installed</Publish>
    </UI>

    <!-- 1 = create the desktop shortcut (checkbox default), 0 = skip. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="wix/license.rtf" />

    <Feature Id="ProductFeature" Title="OpenNex" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <!-- The cleanup component lives under the start-menu Directory (not
           in the ComponentGroup), so reference it explicitly. -->
      <ComponentRef Id="CleanupStartMenuFolder" />
    </Feature>
  </Product>
  <Fragment>
    <!-- WiX requires a single root Directory with Id TARGETDIR and
         Name SourceDir; INSTALLDIR must live underneath it. -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="OpenNex" />
      </Directory>
      <!-- Start-menu subfolder for the shortcuts. The cleanup component is
           nested here (a Component under a Directory inherits it; the
           ComponentGroup's Directory attribute must not be repeated). -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="OpenNex">
          <Component Id="CleanupStartMenuFolder" Guid="*">
            <RemoveFolder Id="RemoveApplicationProgramsFolder"
                          On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\OpenNex"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="MainExecutable" Guid="*">
        <!-- Bind variables parse on '.', so the File Id must not contain
             dots; the on-disk name stays opennex.exe via Name. -->
        <File Id="OpennexExe" Name="opennex.exe" Source="$(var.SourcePath)" KeyPath="yes" />
        <!-- Start-menu shortcut (always created). -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="OpenNex"
                  Description="OpenNex Terminal Manager"
                  WorkingDirectory="INSTALLDIR"
                  Advertise="yes" />
      </Component>
      <!-- Desktop shortcut in its OWN component: component-level
           Conditions are the canonical MSI mechanism for optional
           resources. The checkbox sets INSTALLDESKTOPSHORTCUT=1. -->
      <Component Id="DesktopShortcutComponent" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="OpenNex"
                  Description="OpenNex Terminal Manager"
                  WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU"
                       Key="Software\OpenNex"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <Condition>INSTALLDESKTOPSHORTCUT</Condition>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
