<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="OpenNex"
           Version="$(var.Version)"
           Manufacturer="OpenNex"
           Language="1033"
           UpgradeCode="11111111-2222-3333-4444-555555555555">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="ProductFeature" Title="OpenNex" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>
  <Fragment>
    <!-- WiX requires a single root Directory with Id TARGETDIR and
         Name SourceDir; INSTALLDIR must live underneath it. -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="OpenNex" />
      </Directory>
      <!-- Start-menu subfolder for the shortcuts. -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="OpenNex" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="MainExecutable" Guid="*">
        <!-- Bind variables parse on '.', so the File Id must not contain
             dots; the on-disk name stays opennex.exe via Name. -->
        <File Id="OpennexExe" Name="opennex.exe" Source="$(var.SourcePath)" KeyPath="yes" />
        <!-- Start-menu shortcut. -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="OpenNex"
                  Description="OpenNex Terminal Manager"
                  WorkingDirectory="INSTALLDIR"
                  Advertise="yes" />
        <!-- Desktop shortcut. -->
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="OpenNex"
                  Description="OpenNex Terminal Manager"
                  WorkingDirectory="INSTALLDIR"
                  Advertise="yes" />
      </Component>
      <!-- Cleans up the start-menu subfolder on uninstall (shortcuts alone
           don't remove the directory). -->
      <Component Id="CleanupStartMenuFolder" Guid="*" Directory="ApplicationProgramsFolder">
        <RemoveFolder Id="RemoveApplicationProgramsFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\OpenNex"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
