├── egui_term_local/               # 终端模拟器库（本地 path 依赖）
│   ├── Cargo.toml
│   └── src/
│       ├── backend/               # PTY 后端封装
│       ├── bindings.rs             # 键盘绑定
│       ├── view.rs                 # 终端渲染
│       └── ...
├── locales/                       # 9 种语言 YAML 文件
│   ├── zh.yaml / en.yaml / zh-TW.yaml
│   ├── de.yaml / fr.yaml / ja.yaml
│   └── it.yaml / ko.yaml / hi.yaml
├── src/
│   ├── main.rs                    # 应用入口
│   ├── app.rs                     # 主应用核心（状态、事件、菜单、场景、侧栏）
│   ├── app/
│   │   ├── ssh_ui.rs              # SSH 主机侧栏区 + 编辑/删除弹窗 + 连接
│   │   ├── history_menu.rs        # Alt 历史/收藏菜单 + 相关确认弹窗
